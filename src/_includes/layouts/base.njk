<!DOCTYPE html>
{% set gc_domain = settings.goatcounter_domain_de if (lang | default('de')) == 'de' else settings.goatcounter_domain_pl %}
{% set site_url = settings.site_url_de if (lang | default('de')) == 'de' else settings.site_url_pl %}
<html lang="{{ lang | default('de') }}" data-goatcounter="{{ gc_domain }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if seo_title %}{{ seo_title }}{% elif title %}{{ title }} | {{ site_name }}{% else %}{{ site_name }}{% endif %}</title>
{% if settings.adsense_enabled %}<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1934454305970765" crossorigin="anonymous"></script>{% endif %}
<meta name="description" content="{{ seo_description or description or tagline }}">
<link rel="canonical" href="{{ site_url }}{{ page.url }}">
{# The chia se (Dot 1, Ruler 10:00 28/11): trang truyen co og:type=article
   + anh 1200x630; trang khac co og co ban + anh mac dinh cua ngon ngu. #}
{% if cover %}
<meta property="og:type" content="article">
<meta property="og:title" content="{{ seo_title or title }}">
<meta property="og:description" content="{{ seo_description or description }}">
<meta property="og:url" content="{{ site_url }}{{ page.url }}">
<meta property="og:image" content="{{ site_url }}/img/og/{{ slug }}.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ title }}">
<meta property="og:site_name" content="{{ site_name }}">
<meta property="og:locale" content="{{ 'de_DE' if (lang | default('de')) == 'de' else 'pl_PL' }}">
<meta property="article:published_time" content="{{ date | date('%Y-%m-%d') }}">
<meta name="twitter:card" content="summary_large_image">
{% else %}
<meta property="og:type" content="website">
<meta property="og:title" content="{{ seo_title or title or site_name }}">
<meta property="og:description" content="{{ seo_description or description or tagline }}">
<meta property="og:url" content="{{ site_url }}{{ page.url }}">
<meta property="og:image" content="{{ site_url }}/img/og/default-{{ lang | default('de') }}.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site_name }}">
<meta property="og:site_name" content="{{ site_name }}">
<meta property="og:locale" content="{{ 'de_DE' if (lang | default('de')) == 'de' else 'pl_PL' }}">
<meta name="twitter:card" content="summary_large_image">
{% endif %}
<link rel="stylesheet" href="/assets/css/style.css">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
</head>
<body>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/{{ lang }}/">{{ site_name }}</a>
    <div class="header-right">
      {% if page.url == '/' + (lang | default('de')) + '/' %}
      <div class="header-search">
        <label class="visually-hidden" for="search-input">{{ search_label }}</label>
        <input id="search-input" type="search" data-index="/{{ lang }}/search.json" placeholder="{{ search_placeholder }}" autocomplete="off">
      </div>
      {% endif %}
      {# Nut chuyen ngon ngu DE|PL da bo (Phuong an A, Ruler 15:52 27/11):
         moi web chi 1 ngon ngu, khong link sang ngon ngu kia. #}
    </div>
  </div>
  <p class="tagline wrap">{{ tagline }}</p>
</header>

<main class="wrap">
  {{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap">
    <nav class="footer-nav">
      {% if lang == 'de' %}
        <a href="/de/impressum/">Impressum</a> · <a href="/de/datenschutz/">Datenschutz</a> · <a href="#" id="cookie-settings">Cookie-Einstellungen</a> · <a href="/de/ueber-uns/">Über uns</a> · <a href="/de/kontakt/">Kontakt</a>
      {% else %}
        <a href="/pl/polityka-prywatnosci/">Polityka prywatności</a> · <a href="#" id="cookie-settings">Ustawienia plików cookie</a> · <a href="/pl/kontakt/">Kontakt</a> · <a href="/pl/o-nas/">O nas</a>
      {% endif %}
      {% if build_lang != "pl" %} · <a href="/dashboard/">Dashboard</a>{% endif %}
    </nav>
    <p class="fiction-note">{{ settings.footer_note_de if lang == 'de' else settings.footer_note_pl }}</p>
    <p class="copyright">© {{ "now" | date("%Y") }} {{ site_name }}</p>
  </div>
</footer>

<div id="cookie-banner" class="cookie-banner" hidden>
  <p>{{ cookie_text }}</p>
  <p class="cookie-more">
    {% if lang == 'de' %}
      Mehr dazu in der <a href="/de/datenschutz/">Datenschutzerklärung</a>.
    {% else %}
      Więcej w <a href="/pl/polityka-prywatnosci/">polityce prywatności</a>.
    {% endif %}
  </p>
  <div class="cookie-actions">
    <button id="cookie-accept" type="button">{{ cookie_accept }}</button>
    <button id="cookie-decline" type="button">{{ cookie_decline }}</button>
  </div>
</div>
<script src="/assets/js/cookie.js" defer></script>
</body>
</html>
