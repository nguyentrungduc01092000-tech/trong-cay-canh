---
permalink: /pl/search.json
eleventyExcludeFromCollections: true
---
[
{%- for post in collections.posts_pl -%}
  {
    "title": {{ post.data.title | dump | safe }},
    "slug": {{ post.data.slug | dump | safe }},
    "description": {{ post.data.description | dump | safe }},
    "category": {{ post.data.category | dump | safe }},
    "tags": {{ post.data.tags | dump | safe }},
    "date": {{ post.date | date('%Y-%m-%d') | dump | safe }},
    "url": {{ post.url | dump | safe }}
  }{% if not loop.last %},{% endif %}
{%- endfor -%}
]
