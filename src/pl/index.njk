---
layout: layouts/base.njk
permalink: /pl/
---
<h1 class="section-title">{{ home_title }}</h1>

<p class="fiction-intro">{{ fiction_intro }}</p>

<nav class="cat-nav" aria-label="{{ categories_heading }}">
  <h2>{{ categories_heading }}</h2>
  <ul>
  {% for cat in categories %}
    <li><a href="/pl/kategoria/{{ cat.key }}/">{{ cat.pl }} ({{ collections.posts_pl | categoryCount(cat.pl) }})</a></li>
  {% endfor %}
  </ul>
</nav>

<p id="search-empty" hidden>{{ search_no_results }}</p>

<ul id="post-grid" class="grid">
{% for post in collections.posts_pl %}
  <li class="card" data-slug="{{ post.data.slug }}" data-search="{{ post.data.title }} {{ post.data.description }} {{ post.data.category }} {{ (post.data.tags or []) | join(' ') }}">
    {% if post.data.cover %}
    <a href="{{ post.url }}" tabindex="-1" aria-hidden="true">{% image post.data.cover, post.data.title %}</a>
    {% endif %}
    <div class="card-body">
      <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      <p class="desc">{{ post.data.description }}</p>
      <p class="meta">
        <time datetime="{{ post.date | date('%Y-%m-%d') }}">{{ post.date | dateLocalized(locale) }}</time>
        {% if post.data.category %} · <a href="{{ post.data.category | categoryUrl('pl') }}">{{ post.data.category }}</a>{% endif %}
      </p>
    </div>
  </li>
{% endfor %}
</ul>

<script src="/assets/js/search.js" defer></script>
